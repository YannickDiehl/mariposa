citHeader("To cite mariposa in publications use:")

year <- sub("-.*", "", meta$`Date/Publication`)
if (!length(year)) year <- format(Sys.Date(), "%Y")
note <- sprintf("R package version %s", meta$Version)

bibentry(
  bibtype  = "Manual",
  title    = "{mariposa}: SPSS-Compatible Statistical Tools for Survey Data",
  author   = person("Yannick", "Diehl"),
  year     = year,
  note     = note,
  doi      = "10.32614/CRAN.package.mariposa",
  url      = "https://CRAN.R-project.org/package=mariposa",
  textVersion = paste0(
    "Diehl, Y. (", year, "). ",
    "mariposa: SPSS-Compatible Statistical Tools for Survey Data. ",
    note, ". doi:10.32614/CRAN.package.mariposa"
  )
)
